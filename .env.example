# NesOpenWritter backend env vars
# Copy to .env for local development. In Railway — set in project Variables.

# Server
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL via Railway addon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nesopenwritter

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Better-Auth (generate secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me-with-32-byte-random-string
BETTER_AUTH_URL=http://localhost:8080

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nesopenwritter-assets
R2_PUBLIC_BASE_URL=https://assets.nesopenwritter.example
