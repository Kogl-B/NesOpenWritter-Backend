# NesOpenWritter-Backend — env vars
# Copy to .env for local development. On Railway, set these in the service env.

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Allowed CORS origin (frontend) — comma-separated for multiple
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (Railway managed Postgres injects DATABASE_URL automatically)
DATABASE_URL=postgresql://user:pass@localhost:5432/openwritter?schema=public

# Better-Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:8080

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nesopenwritter-assets
R2_PUBLIC_BASE_URL=https://assets.nesopenwritter.local
