# NesOpenWritter backend env vars
# Copy to .env for local development. In Railway — set in project Variables.

# Server
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
# Local dev (via `pnpm db:up` — docker-compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/nesopenwritter
# Railway: use `${{Postgres.DATABASE_URL}}` reference variable (don't hardcode)

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Better-Auth — REQUIRED
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-byte-random-string
BETTER_AUTH_URL=http://localhost:8080

# Google OAuth — optional. Without these, only email+password is enabled.
# Get from https://console.cloud.google.com (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (S3-compatible object storage) — optional, used in Stage 3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
