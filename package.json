{
  "name": "nesopenwritter-backend",
  "private": true,
  "version": "3.0.0",
  "description": "OpenWritter API — Fastify + Prisma + PostgreSQL (Railway)",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/nowpayments.test.ts src/lib/publish/publish.test.ts src/lib/publish/kit.test.ts src/lib/publish/boostySession.test.ts src/lib/publish/boostyPost.test.ts src/lib/publish/sponsrClient.test.ts src/lib/publish/sponsrSession.test.ts src/lib/publish/sponsrManage.test.ts src/lib/chapterStage.test.ts src/lib/ai/openaiImage.test.ts src/lib/ai/receipt.test.ts src/lib/geo/policy.test.ts src/lib/geo/lookup.test.ts src/lib/notify/drafts.test.ts src/lib/requestSecurity.test.ts",
    "test:advertising": "tsx --test src/routes/advertising.integration.test.ts",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:wipe": "docker compose down -v",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test:stats": "tsx --test src/routes/metrics.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/compress": "^9.2.1",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/sensible": "^6.0.1",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "10.78.0",
    "better-auth": "1.7.28",
    "dotenv": "^17.4.2",
    "fastify": "5.12.8",
    "fastify-plugin": "^5.1.0",
    "geoip-lite": "^2.0.3",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.22.0",
    "resend": "^6.12.3",
    "zod": "4.6.7",
    "sanitize-html": "2.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/sanitize-html": "^2.16.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@3": "3.1.9",
      "fast-copy@3": "3.1.0",
      "fast-xml-parser@5": "5.12.0",
      "js-yaml@4": "4.3.2",
      "brace-expansion@1": "1.1.22",
      "brace-expansion@5": "5.0.12",
      "minimatch@10": "11.0.1",
      "tsx>esbuild": "0.28.2"
    }
  }
}
