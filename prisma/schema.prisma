// NesOpenWritter — backend Prisma schema
// Этапы 0–2: Better-Auth core + domain (Project, Character, Item, Location,
// TimelineEvent, Chapter, Tag + связи).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better-Auth core models
// ---------------------------------------------------------------------------

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  emailVerified    Boolean  @default(false)
  name             String?
  image            String?
  settings         Json     @default("{}")
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions   Session[]
  accounts   Account[]
  projects   Project[]
  twoFactors TwoFactor[]

  @@map("users")
}

model TwoFactor {
  id          String  @id @default(cuid())
  userId      String
  secret      String
  backupCodes String
  verified    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Project (root of every domain object)
// ---------------------------------------------------------------------------

model Project {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  characters  Character[]
  items       Item[]
  locations   Location[]
  events      TimelineEvent[]
  chapters    Chapter[]
  tags        Tag[]
  mapElements MapElement[]
  mapDrawings MapDrawing[]
  snapshots   WorldSnapshot[]
  WikiPage    WikiPage[]

  @@index([ownerId])
  @@map("projects")
}

// ---------------------------------------------------------------------------
// Characters
// ---------------------------------------------------------------------------

model Character {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  shortName    String?
  portraitPath String?
  summary      String?
  biography    String?
  faction      String?
  status       String   @default("alive")
  dateOfBirth  String?
  dateOfDeath  String?
  traits       String[] @default([])
  abilities    String[] @default([])
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // outgoing/incoming relations
  outgoingRelations CharacterRelation[] @relation("CharacterRelationFrom")
  incomingRelations CharacterRelation[] @relation("CharacterRelationTo")

  // genealogy edges
  asParent GenealogyEdge[] @relation("GenealogyParent")
  asChild  GenealogyEdge[] @relation("GenealogyChild")

  // event participation
  eventLinks EventCharacter[]

  // map positions
  positions CharacterPosition[]

  // items currently owned
  ownedItems Item[] @relation("ItemCurrentOwner")

  @@index([projectId])
  @@map("characters")
}

model CharacterRelation {
  id              String   @id @default(cuid())
  projectId       String
  fromCharacterId String
  toCharacterId   String
  relationType    String
  strength        Int      @default(50)
  description     String?
  createdAt       DateTime @default(now())

  fromCharacter Character @relation("CharacterRelationFrom", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacter   Character @relation("CharacterRelationTo", fields: [toCharacterId], references: [id], onDelete: Cascade)

  @@unique([fromCharacterId, toCharacterId, relationType])
  @@index([projectId])
  @@index([fromCharacterId])
  @@index([toCharacterId])
  @@map("character_relations")
}

model GenealogyEdge {
  id        String   @id @default(cuid())
  projectId String
  parentId  String
  childId   String
  kind      String   @default("biological")
  createdAt DateTime @default(now())

  parent Character @relation("GenealogyParent", fields: [parentId], references: [id], onDelete: Cascade)
  child  Character @relation("GenealogyChild", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId, kind])
  @@index([projectId])
  @@map("genealogy_edges")
}

// ---------------------------------------------------------------------------
// Items
// ---------------------------------------------------------------------------

model Item {
  id                String   @id @default(cuid())
  projectId         String
  name              String
  shortName         String?
  imagePath         String?
  category          String   @default("other")
  rarity            String   @default("common")
  summary           String?
  description       String?
  properties        Json     @default("{}")
  currentOwnerId    String?
  currentLocationId String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentOwner    Character?          @relation("ItemCurrentOwner", fields: [currentOwnerId], references: [id], onDelete: SetNull)
  currentLocation Location?           @relation("ItemCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  timelinePoints  ItemTimelinePoint[]
  eventLinks      EventItem[]

  @@index([projectId])
  @@index([currentOwnerId])
  @@index([currentLocationId])
  @@map("items")
}

model ItemTimelinePoint {
  id         String   @id @default(cuid())
  projectId  String
  itemId     String
  at         String
  ownerId    String?
  locationId String?
  eventId    String?
  note       String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([itemId])
  @@map("item_timeline_points")
}

// ---------------------------------------------------------------------------
// Locations
// ---------------------------------------------------------------------------

model Location {
  id               String   @id @default(cuid())
  projectId        String
  name             String
  shortName        String?
  kind             String   @default("place")
  parentLocationId String?
  lodLevel         Int      @default(0)
  coordX           Float?
  coordY           Float?
  description      String?
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentLocation Location?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  children       Location[] @relation("LocationHierarchy")

  // back-relations
  itemsHere   TimelineEvent[]
  itemsHosted Item[]              @relation("ItemCurrentLocation")
  positions   CharacterPosition[]
  mapElements MapElement[]

  @@index([projectId])
  @@index([parentLocationId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Timeline events
// ---------------------------------------------------------------------------

model TimelineEvent {
  snapshots       WorldSnapshot[]
  id              String          @id @default(cuid())
  projectId       String
  name            String
  summary         String?
  description     String?
  at              String
  atNumeric       Float?
  durationNumeric Float?
  locationId      String?
  color           String?
  icon            String?
  importance      Int             @default(3)
  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location   Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  characters EventCharacter[]
  items      EventItem[]
  positions  CharacterPosition[]
  chapters   Chapter[]

  @@index([projectId])
  @@index([locationId])
  @@map("timeline_events")
}

model EventCharacter {
  eventId     String
  characterId String
  role        String   @default("participant")
  note        String?
  createdAt   DateTime @default(now())

  event     TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  character Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([eventId, characterId])
  @@index([characterId])
  @@map("event_characters")
}

model EventItem {
  eventId   String
  itemId    String
  note      String?
  createdAt DateTime @default(now())

  event TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  item  Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([eventId, itemId])
  @@index([itemId])
  @@map("event_items")
}

model CharacterPosition {
  id          String   @id @default(cuid())
  projectId   String
  characterId String
  eventId     String
  locationId  String?
  coordX      Float?
  coordY      Float?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  character Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  event     TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location  Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([characterId, eventId])
  @@index([projectId])
  @@map("character_positions")
}

// ---------------------------------------------------------------------------
// Chapters / scenes (Phase 4 base — model only, editor wiring later)
// ---------------------------------------------------------------------------

model Chapter {
  id         String   @id @default(cuid())
  projectId  String
  parentId   String?
  kind       String   @default("chapter")
  title      String
  summary    String?
  content    Json     @default("{}")
  orderIndex Int      @default(0)
  wordCount  Int      @default(0)
  eventId    String?
  locationId String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Chapter?          @relation("ChapterTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Chapter[]         @relation("ChapterTree")
  event     TimelineEvent?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  revisions ChapterRevision[]
  mentions  SceneMention[]

  @@index([projectId])
  @@index([parentId])
  @@map("chapters")
}

// ---------------------------------------------------------------------------
// Tags (polymorphic — links via EntityTag with entityType discriminator)
// ---------------------------------------------------------------------------

model Tag {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  color       String   @default("#888888")
  description String?
  createdAt   DateTime @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links   EntityTag[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("tags")
}

model EntityTag {
  tagId      String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("entity_tags")
}

// ---------------------------------------------------------------------------
// Map elements & drawings (Этап 3)
// ---------------------------------------------------------------------------

model MapElement {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  kind        String // marker | line | area
  subkind     String?
  locationId  String?
  geometry    Json     @default("{}")
  style       Json     @default("{}")
  lodMin      Int      @default(0)
  lodMax      Int      @default(4)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([locationId])
  @@map("map_elements")
}

model MapDrawing {
  id        String   @id @default(cuid())
  projectId String
  name      String
  layer     String   @default("default")
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("map_drawings")
}

// ---------------------------------------------------------------------------
// Chapter revisions & scene mentions (Этап 4)
// ---------------------------------------------------------------------------

model ChapterRevision {
  id        String   @id @default(cuid())
  chapterId String
  label     String?
  content   Json     @default("{}")
  wordCount Int      @default(0)
  createdAt DateTime @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("chapter_revisions")
}

model SceneMention {
  sceneId    String
  entityType String
  entityId   String
  count      Int    @default(1)

  scene Chapter @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@id([sceneId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("scene_mentions")
}

// v1.1 — Снапшоты состояния мира
model WorldSnapshot {
  id          String   @id @default(cuid())
  projectId   String
  eventId     String?
  name        String
  description String?
  state       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event   TimelineEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([eventId])
  @@map("world_snapshots")
}

// v1.2 — Вики проекта
model WikiPage {
  id          String   @id @default(cuid())
  projectId   String
  slug        String
  title       String
  content     String   @db.Text
  category    String? // например: «Лор», «Магия», «География», «История»
  tags        String[] @default([])
  links       Json     @default("[]") // [{ pageId, label }] — внутренние ссылки
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("wiki_pages")
}
