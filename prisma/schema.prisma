// NesOpenWritter — backend Prisma schema
// Этапы 0–2: Better-Auth core + domain (Project, Character, Item, Location,
// TimelineEvent, Chapter, Tag + связи).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better-Auth core models
// ---------------------------------------------------------------------------

model User {
  collaborations   ProjectCollaborator[]
  id               String                @id @default(cuid())
  email            String                @unique
  emailVerified    Boolean               @default(false)
  name             String?
  image            String?
  settings         Json                  @default("{}")
  twoFactorEnabled Boolean               @default(false)
  /// Тариф подписки (backend/src/lib/tiers.ts); null/мусор = 'test'
  plan             String?
  /// Статус аккаунта: test | regular | admin. Не путать с тарифом подписки.
  accountStatus    String                @default("test")
  /// Баланс на будущие ИИ-продукты, центы USD
  aiBalanceCents   Int                   @default(0)
  walletBalanceCents BigInt               @default(0)
  rubBalanceCents    BigInt               @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  sessions    Session[]
  accounts    Account[]
  projects    Project[]
  twoFactors  TwoFactor[]
  integrations UserIntegration[]
  dictionaryEntries DictionaryEntry[]
  cryptoPayments CryptoPayment[]
  blogPosts    BlogPost[]
  blogProfile  BlogProfile?
  authorLevels AuthorLevel[]
  followsOut   AuthorFollow[] @relation("Follower")
  followsIn    AuthorFollow[] @relation("AuthorFollowed")
  subscriptionsOut AuthorSubscription[] @relation("Subscriber")
  subscriptionsIn  AuthorSubscription[] @relation("SubscribedAuthor")
  blogComments BlogComment[]
  blogLikes    BlogLike[]
  blogReports  BlogReport[]
  blogDonations BlogDonation[]
  blogModerations BlogModerator[]
  aiUsages     AiUsage[]
  errorReports AppErrorReport[]
  readProgress ReadProgress[]
  bookSubscriptions BookSubscription[]
  chapterRevisions ChapterRevision[]
  publishAccounts  PublishAccount[]
  publishVaults    PublishVault[]
  publishLinks     PublishLink[]
  publishDeliveries PublishDelivery[]
  readerNotices    ReaderNotice[]
  notifications    Notification[]
  storedFiles      StoredFile[]
  aiJobs           AiJob[]
  photoShares      PhotoShare[]  @relation("PhotoOwner")
  photoViews       PhotoViewer[] @relation("PhotoViewer")

  @@map("users")
}

model BlogProfile {
  authorId             String @id
  nickname             String? @unique
  title                String @default("")
  description          String @default("")
  defaultAudience      String @default("all")
  defaultCommentAccess String @default("all")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("blog_profiles")
}

model AuthorLevel {
  id          String   @id @default(cuid())
  authorId    String
  title       String
  description String   @default("")
  /// Цена в рублях за месяц
  priceRub    Int
  avatar      String   @default("")
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author        User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts         BlogPost[]
  subscriptions AuthorSubscription[]

  @@index([authorId])
  @@map("author_levels")
}

model AuthorFollow {
  userId    String
  authorId  String
  createdAt DateTime @default(now())

  user   User @relation("Follower", fields: [userId], references: [id], onDelete: Cascade)
  author User @relation("AuthorFollowed", fields: [authorId], references: [id], onDelete: Cascade)

  @@id([userId, authorId])
  @@index([authorId])
  @@map("author_follows")
}

model AuthorSubscription {
  id        String   @id @default(cuid())
  userId    String
  authorId  String
  levelId   String
  createdAt DateTime @default(now())
  expiresAt DateTime?
  cancelledAt DateTime?

  user   User        @relation("Subscriber", fields: [userId], references: [id], onDelete: Cascade)
  author User        @relation("SubscribedAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  level  AuthorLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, authorId])
  @@index([authorId])
  @@map("author_subscriptions")
}

/// История доступа и зачислений. Сумма в копейках BYN и название уровня фиксируются при операции.
model BlogAudienceEvent {
  id          String    @id @default(cuid())
  authorId    String
  userId      String
  kind        String
  requestId   String?
  levelId     String?
  levelTitle  String    @default("")
  priceRub    Int       @default(0)
  amountCents Int       @default(0)
  reason      String    @default("")
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, requestId])
  @@index([authorId, createdAt])
  @@map("blog_audience_events")
}

model BlogTrafficDay {
  authorId String
  day      String
  source   String
  views    Int @default(0)

  @@id([authorId, day, source])
  @@map("blog_traffic_days")
}

model BlogPost {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  body      String
  topic     String   @default("")
  tags      String[] @default([])
  attachment Json?
  views     Int      @default(0)
  published Boolean  @default(false)
  publishedAt DateTime?
  /// Уровень подписки, без которого текст закрыт. Пусто — запись для всех.
  levelId   String?
  /// all | subscribers | level | self
  audience  String   @default("all")
  /// all | subscribers | none
  commentAccess String @default("all")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  level     AuthorLevel?  @relation(fields: [levelId], references: [id], onDelete: SetNull)
  comments  BlogComment[]
  moderators BlogModerator[]
  likes     BlogLike[]
  reports   BlogReport[]
  donations BlogDonation[]
  readers   BlogPostReader[]

  @@index([authorId, updatedAt])
  @@index([published, createdAt])
  @@index([published, publishedAt])
  @@map("blog_posts")
}

model BlogModerator {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("blog_moderators")
}

model BlogComment {
  id         String   @id @default(cuid())
  postId     String
  userId     String
  authorName String   @default("")
  body       String
  /// Пусто — комментарий к записи. Иначе ответ на комментарий с этим id.
  parentId   String   @default("")
  createdAt  DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  files BlogCommentFile[]

  @@index([postId, createdAt])
  @@map("blog_comments")
}

model BlogCommentFile {
  id        String @id @default(cuid())
  commentId String
  position  Int    @default(0)
  name      String
  size      Int
  data      Bytes

  comment BlogComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, position])
  @@map("blog_comment_files")
}

model BlogLike {
  userId    String
  postId    String
  emoji     String   @default("heart")
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("blog_likes")
}

model BlogReport {
  id        String   @id @default(cuid())
  postId    String?
  postTitle String   @default("")
  userId    String
  note      String   @default("")
  kind      String   @default("complaint")
  status    String   @default("new")
  createdAt DateTime @default(now())

  post BlogPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([createdAt, id])
  @@index([kind, status, createdAt])
  @@map("blog_reports")
}

model BlogDonation {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  amountRub Int
  note      String   @default("")
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("blog_donations")
}

model BlogPostReader {
  postId          String
  readerKey       String
  subscriberViews Int @default(0)
  otherViews      Int @default(0)

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, readerKey])
  @@map("blog_post_readers")
}

/// Журнал переводов сохраняется при удалении публикации.
model BlogWalletDonation {
  id          String   @id @default(cuid())
  requestId   String
  senderId    String
  authorId    String
  postId      String
  postTitle   String
  amountCents Int
  note        String
  createdAt   DateTime @default(now())

  @@unique([senderId, requestId])
  @@index([authorId])
  @@index([authorId, createdAt])
  @@map("blog_wallet_donations")
}

/// Квитанции за сервисные тарифы и конвертацию между кошельками.
model WalletOperation {
  userId        String
  requestId     String
  kind          String
  sourceCents   Int
  receivedCents Int
  rateUnits     Int?
  fromCurrency  String?
  toCurrency    String?
  exchangeQuote Json?
  plan          String?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  @@id([userId, requestId])
  @@index([userId, kind, plan, expiresAt])
  @@map("wallet_operations")
}

/// Счёт NOWPayments. Создаётся только когда криптооплата включена.
model CryptoPayment {
  id             String    @id @default(cuid())
  userId         String
  provider       String    @default("nowpayments")
  purpose        String    @default("ai_balance")
  amountUsdCents Int
  status         String    @default("pending")
  providerId       String?
  invoiceUrl       String?
  priceQuote       Json?
  /// Сколько центов USD уже зачислено. Частичная оплата меньше суммы счёта.
  creditedUsdCents Int       @default(0)
  creditedAt       DateTime?
  reversedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("crypto_payments")
}

/// Внешние интеграции пользователя (Google Drive и т.п.)
model UserIntegration {
  id           String    @id @default(cuid())
  userId       String
  provider     String // 'gdrive'
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  email        String? // подключённый аккаунт Google
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("user_integrations")
}

model TwoFactor {
  id          String  @id @default(cuid())
  userId      String
  secret      String
  backupCodes String
  verified    Boolean @default(false)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Project (root of every domain object)
// ---------------------------------------------------------------------------

model Project {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner               User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  characters          Character[]
  items               Item[]
  locations           Location[]
  events              TimelineEvent[]
  chapters            Chapter[]
  tags                Tag[]
  mapElements         MapElement[]
  mapDrawings         MapDrawing[]
  snapshots           WorldSnapshot[]
  WikiPage            WikiPage[]
  Currency            Currency[]
  Resource            Resource[]
  TradeRoute          TradeRoute[]
  KnowledgeEntry      KnowledgeEntry[]
  Calendar            Calendar[]
  TraitInheritance    TraitInheritance[]
  InvestigationPin    InvestigationPin[]
  InvestigationThread InvestigationThread[]
  ExportJob           ExportJob[]
  ProjectCollaborator ProjectCollaborator[]
  dictionaryEntries   DictionaryEntry[]
  calculators         Calculator[]
  characterLedger     CharacterLedger[]
  bookSubscriptions   BookSubscription[]
  readerNotices       ReaderNotice[]
  publishLinks        PublishLink[]
  storedFiles         StoredFile[]

  @@index([ownerId])
  @@map("projects")
}

/// Файл в хранилище кабинета. Размер входит в занятое место тарифа.
model StoredFile {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  key       String   @unique
  sizeBytes Int
  kind      String   @default("other")
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("stored_files")
}

/// Кто может открыть кадр из «Моих фото» и по прямой ссылке.
model PhotoShare {
  id         String   @id @default(cuid())
  userId     String
  hrefHash   String
  href       String
  title      String   @default("")
  /// private | link | people | public
  visibility String   @default("private")
  token      String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner   User          @relation("PhotoOwner", fields: [userId], references: [id], onDelete: Cascade)
  viewers PhotoViewer[]

  @@unique([userId, hrefHash])
  @@index([userId])
  @@map("photo_shares")
}

model PhotoViewer {
  photoId   String
  viewerId  String
  createdAt DateTime @default(now())

  photo  PhotoShare @relation(fields: [photoId], references: [id], onDelete: Cascade)
  viewer User       @relation("PhotoViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@id([photoId, viewerId])
  @@index([viewerId])
  @@map("photo_viewers")
}

// ---------------------------------------------------------------------------
// Characters
// ---------------------------------------------------------------------------

model Character {
  knowledge    KnowledgeEntry[]
  id           String           @id @default(cuid())
  projectId    String
  name         String
  shortName    String?
  portraitPath String?
  summary      String?
  biography    String?
  faction      String?
  /// male | female | other; пусто — пол не указан
  gender       String?
  status       String           @default("alive")
  dateOfBirth  String?
  dateOfDeath  String?
  traits       String[]         @default([])
  abilities    String[]         @default([])
  metadata     Json             @default("{}")
  /// Карточка собрана инструментом «создание ИИ».
  aiCreated    Boolean          @default(false)
  /// Карточку смотрел инструмент «проверка ИИ».
  aiReviewed   Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // outgoing/incoming relations
  outgoingRelations CharacterRelation[] @relation("CharacterRelationFrom")
  incomingRelations CharacterRelation[] @relation("CharacterRelationTo")

  // genealogy edges
  asParent GenealogyEdge[] @relation("GenealogyParent")
  asChild  GenealogyEdge[] @relation("GenealogyChild")

  // event participation
  eventLinks EventCharacter[]

  // map positions
  positions CharacterPosition[]

  // items currently owned
  ownedItems Item[] @relation("ItemCurrentOwner")

  ledger CharacterLedger[]

  @@index([projectId])
  @@map("characters")
}

/// Словари пользователя: фракции, способности и родословные. projectId пустой —
/// словарь общий для всех проектов этого пользователя.
model DictionaryEntry {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  /// faction | ability | lineage
  kind      String
  value     String
  /// Карточка фракции, способности или рода.
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([projectId])
  @@map("dictionary_entries")
}

model CharacterRelation {
  id              String   @id @default(cuid())
  projectId       String
  fromCharacterId String
  toCharacterId   String
  relationType    String
  strength        Int      @default(50)
  description     String?
  createdAt       DateTime @default(now())

  fromCharacter Character @relation("CharacterRelationFrom", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacter   Character @relation("CharacterRelationTo", fields: [toCharacterId], references: [id], onDelete: Cascade)

  @@unique([fromCharacterId, toCharacterId, relationType])
  @@index([projectId])
  @@index([fromCharacterId])
  @@index([toCharacterId])
  @@map("character_relations")
}

model GenealogyEdge {
  id        String   @id @default(cuid())
  projectId String
  parentId  String
  childId   String
  kind      String   @default("biological")
  createdAt DateTime @default(now())

  parent Character @relation("GenealogyParent", fields: [parentId], references: [id], onDelete: Cascade)
  child  Character @relation("GenealogyChild", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId, kind])
  @@index([projectId])
  @@map("genealogy_edges")
}

// ---------------------------------------------------------------------------
// Items
// ---------------------------------------------------------------------------

model Item {
  id                String   @id @default(cuid())
  projectId         String
  name              String
  shortName         String?
  imagePath         String?
  category          String   @default("other")
  rarity            String   @default("common")
  summary           String?
  description       String?
  properties        Json     @default("{}")
  currentOwnerId    String?
  currentLocationId String?
  metadata          Json     @default("{}")
  /// Карточка собрана инструментом «создание ИИ».
  aiCreated         Boolean  @default(false)
  /// Карточку смотрел инструмент «проверка ИИ».
  aiReviewed        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentOwner    Character?          @relation("ItemCurrentOwner", fields: [currentOwnerId], references: [id], onDelete: SetNull)
  currentLocation Location?           @relation("ItemCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  timelinePoints  ItemTimelinePoint[]
  eventLinks      EventItem[]

  @@index([projectId])
  @@index([currentOwnerId])
  @@index([currentLocationId])
  @@map("items")
}

model ItemTimelinePoint {
  id         String   @id @default(cuid())
  projectId  String
  itemId     String
  at         String
  ownerId    String?
  locationId String?
  eventId    String?
  note       String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([itemId])
  @@map("item_timeline_points")
}

// ---------------------------------------------------------------------------
// Locations
// ---------------------------------------------------------------------------

model Location {
  tradeRoutesFrom  TradeRoute[] @relation("tradeFrom")
  tradeRoutesTo    TradeRoute[] @relation("tradeTo")
  id               String       @id @default(cuid())
  projectId        String
  name             String
  shortName        String?
  kind             String       @default("place")
  parentLocationId String?
  lodLevel         Int          @default(0)
  coordX           Float?
  coordY           Float?
  description      String?
  metadata         Json         @default("{}")
  /// Карточка собрана инструментом «создание ИИ».
  aiCreated        Boolean      @default(false)
  /// Карточку смотрел инструмент «проверка ИИ».
  aiReviewed       Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentLocation Location?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  children       Location[] @relation("LocationHierarchy")

  // back-relations
  itemsHere   TimelineEvent[]
  itemsHosted Item[]              @relation("ItemCurrentLocation")
  positions   CharacterPosition[]
  mapElements MapElement[]

  @@index([projectId])
  @@index([parentLocationId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Timeline events
// ---------------------------------------------------------------------------

model TimelineEvent {
  snapshots       WorldSnapshot[]
  id              String          @id @default(cuid())
  projectId       String
  name            String
  summary         String?
  description     String?
  at              String
  atNumeric       Float?
  durationNumeric Float?
  locationId      String?
  color           String?
  icon            String?
  importance      Int             @default(3)
  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location       Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  characters     EventCharacter[]
  items          EventItem[]
  positions      CharacterPosition[]
  chapters       Chapter[]
  KnowledgeEntry KnowledgeEntry[]
  manuscriptSources TimelineReview[]

  @@index([projectId])
  @@index([locationId])
  @@map("timeline_events")
}

model EventCharacter {
  eventId     String
  characterId String
  role        String   @default("participant")
  note        String?
  createdAt   DateTime @default(now())

  event     TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  character Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([eventId, characterId])
  @@index([characterId])
  @@map("event_characters")
}

model EventItem {
  eventId   String
  itemId    String
  note      String?
  createdAt DateTime @default(now())

  event TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  item  Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([eventId, itemId])
  @@index([itemId])
  @@map("event_items")
}

model CharacterPosition {
  id          String   @id @default(cuid())
  projectId   String
  characterId String
  eventId     String
  locationId  String?
  coordX      Float?
  coordY      Float?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  character Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  event     TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location  Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([characterId, eventId])
  @@index([projectId])
  @@map("character_positions")
}

// ---------------------------------------------------------------------------
// Chapters / scenes (Phase 4 base — model only, editor wiring later)
// ---------------------------------------------------------------------------

model Chapter {
  id         String   @id @default(cuid())
  projectId  String
  parentId   String?
  kind       String   @default("chapter")
  title      String
  summary    String?
  content    Json     @default("{}")
  orderIndex Int      @default(0)
  wordCount  Int      @default(0)
  /// Длина видимого текста, без разметки. Считается при сохранении главы.
  charCount  Int      @default(0)
  /// Текст главы вставлен инструментом «создание ИИ».
  aiCreated  Boolean  @default(false)
  /// Текст смотрел инструмент «проверка ИИ».
  aiReviewed Boolean  @default(false)
  /// new | writing | done | checked | published | scheduled
  stage      String   @default("new")
  /// Момент для статуса «публикация запланирована».
  publishAt  DateTime?
  /// Теги этой главы для площадок. Не теги мира.
  tags       String[] @default([])
  eventId    String?
  locationId String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Chapter?          @relation("ChapterTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Chapter[]         @relation("ChapterTree")
  event     TimelineEvent?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  revisions ChapterRevision[]
  timelineJobs AiJob[]
  mentions  SceneMention[]
  ledger    CharacterLedger[]
  reads     ReadProgress[]
  publishDeliveries PublishDelivery[]
  readerNotices ReaderNotice[]

  @@index([projectId])
  @@index([parentId])
  @@index([stage, publishAt])
  @@map("chapters")
}

// ---------------------------------------------------------------------------
// Tags (polymorphic — links via EntityTag with entityType discriminator)
// ---------------------------------------------------------------------------

model Tag {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  color       String   @default("#888888")
  description String?
  createdAt   DateTime @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links   EntityTag[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("tags")
}

model EntityTag {
  tagId      String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("entity_tags")
}

// ---------------------------------------------------------------------------
// Map elements & drawings (Этап 3)
// ---------------------------------------------------------------------------

model MapElement {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  kind        String // marker | line | area
  subkind     String?
  locationId  String?
  geometry    Json     @default("{}")
  style       Json     @default("{}")
  lodMin      Int      @default(0)
  lodMax      Int      @default(4)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([locationId])
  @@map("map_elements")
}

model MapDrawing {
  id        String   @id @default(cuid())
  projectId String
  name      String
  layer     String   @default("default")
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("map_drawings")
}

// ---------------------------------------------------------------------------
// Chapter revisions & scene mentions (Этап 4)
// ---------------------------------------------------------------------------

model ChapterRevision {
  id        String   @id @default(cuid())
  chapterId String
  /// Аккаунт, который сохранил эту версию. Пусто у записей до мультидоступа.
  authorId  String?
  label     String?
  content   Json     @default("{}")
  wordCount Int      @default(0)
  createdAt DateTime @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([chapterId])
  @@index([authorId])
  @@map("chapter_revisions")
}

model SceneMention {
  sceneId    String
  entityType String
  entityId   String
  count      Int    @default(1)

  scene Chapter @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@id([sceneId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("scene_mentions")
}

// v1.1 — Снапшоты состояния мира
model WorldSnapshot {
  id          String   @id @default(cuid())
  projectId   String
  eventId     String?
  name        String
  description String?
  state       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event   TimelineEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([eventId])
  @@map("world_snapshots")
}

// Калькуляторы персонажа: деньги, шмотки и свои классы.
// В тексте сцены пишутся как @Имя+300zm — запись попадает в журнал.
model Calculator {
  id        String   @id @default(cuid())
  projectId String
  /// Короткий код в тексте: zm, sm, меч
  key       String
  name      String
  /// money | item — позже сюда же встанут системы вроде rpg
  kind      String   @default("money")
  unit      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entries CharacterLedger[]

  @@unique([projectId, key])
  @@index([projectId])
  @@map("calculators")
}

model CharacterLedger {
  id           String   @id @default(cuid())
  projectId    String
  characterId  String
  calculatorId String
  chapterId    String?
  delta        Float
  note         String?
  createdAt    DateTime @default(now())

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character  Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  calculator Calculator  @relation(fields: [calculatorId], references: [id], onDelete: Cascade)
  chapter    Chapter?    @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([characterId, calculatorId])
  @@index([chapterId])
  @@map("character_ledger")
}

// v1.2 — Вики проекта
model WikiPage {
  id          String   @id @default(cuid())
  projectId   String
  slug        String
  title       String
  content     String   @db.Text
  category    String? // например: «Лор», «Магия», «География», «История»
  tags        String[] @default([])
  links       Json     @default("[]") // [{ pageId, label }] — внутренние ссылки
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("wiki_pages")
}

// v1.3 — Экономика
model Currency {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  code         String
  symbol       String?
  exchangeRate Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resources Resource[]

  @@unique([projectId, code])
  @@map("currencies")
}

model Resource {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  category    String
  rarity      String   @default("common")
  description String?
  unit        String   @default("unit")
  basePrice   Float?
  currencyId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currency Currency? @relation(fields: [currencyId], references: [id], onDelete: SetNull)

  @@unique([projectId, name])
  @@map("resources")
}

model TradeRoute {
  id             String   @id @default(cuid())
  projectId      String
  name           String
  fromLocationId String?
  toLocationId   String?
  distanceKm     Float?
  travelDays     Int?
  danger         String   @default("low")
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromLocation Location? @relation("tradeFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location? @relation("tradeTo", fields: [toLocationId], references: [id], onDelete: SetNull)

  @@map("trade_routes")
}

// v1.4 — Туман войны (знания персонажа)
model KnowledgeEntry {
  id          String   @id @default(cuid())
  projectId   String
  characterId String
  eventId     String? // на каком событие персонаж узнал
  topic       String // "location:xyz", "character:abc", "secret:n"
  known       Boolean  @default(true)
  detail      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  event     TimelineEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([characterId, topic])
  @@index([projectId])
  @@map("knowledge_entries")
}

// v1.5 — Календарь
model Calendar {
  id            String   @id @default(cuid())
  projectId     String
  name          String
  isDefault     Boolean  @default(false)
  monthsPerYear Int      @default(12)
  daysPerMonth  Int      @default(30)
  hoursPerDay   Int      @default(24)
  moonCount     Int      @default(1)
  epochName     String   @default("Epoch")
  currentYear   Int      @default(1)
  settings      Json     @default("{}") // фазы лун, затмения, праздники
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("calendars")
}

// v1.6 — Генеалогический симулятор
model TraitInheritance {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  type        String   @default("physical") // physical, mental, magical, skill
  dominant    Boolean  @default(true) // доминантный или рецессивный
  probability Float    @default(0.5) // вероятность наследования
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@map("trait_inheritances")
}

// v1.7 — Доска расследований
model InvestigationPin {
  threadsFrom InvestigationThread[] @relation("threadFrom")
  threadsTo   InvestigationThread[] @relation("threadTo")
  id          String                @id @default(cuid())
  projectId   String
  boardId     String? // null = основная доска
  x           Float                 @default(0)
  y           Float                 @default(0)
  label       String
  entityType  String? // character/item/location/event
  entityId    String?
  note        String?
  color       String                @default("#f7bd48")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("investigation_pins")
}

model InvestigationThread {
  id        String   @id @default(cuid())
  projectId String
  fromPinId String
  toPinId   String
  label     String?
  createdAt DateTime @default(now())

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromPin InvestigationPin @relation("threadFrom", fields: [fromPinId], references: [id], onDelete: Cascade)
  toPin   InvestigationPin @relation("threadTo", fields: [toPinId], references: [id], onDelete: Cascade)

  @@map("investigation_threads")
}

// v2.0 — Экспорт/импорт
model ExportJob {
  id        String   @id @default(cuid())
  projectId String
  format    String // json, markdown, epub
  status    String   @default("pending") // pending, done, failed
  resultUrl String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("export_jobs")
}

// v3.0 — Совместная работа
model ProjectCollaborator {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  role        String   @default("editor") // viewer, editor, admin
  invitedById String?
  status      String   @default("active") // pending, active, revoked
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_collaborators")
}

/// Сообщение читателя автору: выделенный фрагмент и возможная опечатка.
model ReaderReport {
  id        String   @id @default(cuid())
  projectId String
  chapterId String
  authorId  String
  quote     String
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([authorId, createdAt])
  @@map("reader_reports")
}

/// Лайк, избранное, полка чтения и отметка «сейчас читает».
model BookReaction {
  userId     String
  projectId  String
  liked      Boolean   @default(false)
  disliked   Boolean   @default(false)
  favorite   Boolean   @default(false)
  /// reading | later | done | skip | пусто
  shelf      String    @default("")
  lastReadAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@id([userId, projectId])
  @@index([projectId, liked])
  @@index([projectId, lastReadAt])
  @@map("book_reactions")
}

/// Отметка «подписан на эту книгу». Деньги не списывает.
model BookSubscription {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId, createdAt])
  @@map("book_subscriptions")
}

model BookView {
  id        String   @id @default(cuid())
  projectId String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("book_views")
}

/// Ключ штатного ИИ. В базе только шифр, в ответах API секрета нет.
model AiProvider {
  id                String   @id @default(cuid())
  provider          String   @unique
  label             String
  keyCipher         String   @default("")
  keyHint           String   @default("")
  baseUrl           String   @default("https://api.deepseek.com")
  model             String   @default("deepseek-flash")
  enabled           Boolean  @default(false)
  /// Внепиковая цена, миллионные доли доллара за 1 млн токенов.
  inputMissUsdPerM  Int      @default(150000)
  inputHitUsdPerM   Int      @default(3000)
  outputUsdPerM     Int      @default(600000)
  /// Во сколько раз дороже пиковые часы DeepSeek.
  peakMultiplier    Int      @default(2)
  /// Во сколько раз цена для пользователя выше себестоимости токенов.
  chargeMultiplier  Int      @default(3)
  /// Настройки генерации картинок: размер, качество, формат, фон.
  generation        Json     @default("{}")
  /// Квота токенов на 30 дней. 0 — без потолка.
  testQuota         Int      @default(30000)
  regularQuota      Int      @default(300000)
  adminQuota        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("ai_providers")
}

/// Один вызов штатного ИИ. Аккаунт — userId, книга — projectId, если вызов был из проекта.
model AiUsage {
  id                String   @id @default(cuid())
  userId            String
  projectId         String?
  provider          String
  model             String
  purpose           String
  promptTokens      Int
  completionTokens  Int
  cacheHitTokens    Int      @default(0)
  cacheMissTokens   Int      @default(0)
  totalTokens       Int
  costUsdMicros     Int
  peak              Boolean  @default(false)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([createdAt])
  @@map("ai_usages")
}

/// Генерация, которую доводит сервер. Закрытая вкладка не отменяет уже принятую задачу.
model AiJob {
  id         String    @id @default(cuid())
  userId     String
  projectId  String    @default("")
  /// image | text | cover | timeline
  kind       String
  /// queued | running | done | failed
  status     String    @default("queued")
  request    Json
  result     Json?
  error      String    @default("")
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  timelineChapterId String?
  timelineKey       String? @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  timelineChapter Chapter? @relation(fields: [timelineChapterId], references: [id], onDelete: Cascade)
  timelineReviews TimelineReview[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([timelineChapterId, createdAt])
  @@map("ai_jobs")
}

/// Решение автора по предложению ИИ. Принятая запись связывает сюжетное
/// событие с конкретным фрагментом сохранённой версии сцены.
model TimelineReview {
  jobId         String
  proposalIndex Int
  eventId       String?
  disposition   String
  quote         String
  createdAt     DateTime @default(now())

  job   AiJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  event TimelineEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@id([jobId, proposalIndex])
  @@index([eventId])
  @@map("timeline_reviews")
}

/// Сообщение об ошибке, которое пользователь отправил из шапки.
model AppErrorReport {
  id        String   @id @default(cuid())
  userId    String
  message   String
  page      String   @default("")
  status    String   @default("new")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
  @@map("app_error_reports")
}

model BookComment {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  authorName String   @default("")
  body       String
  chapterId  String   @default("")
  /// Пусто — комментарий к книге. Иначе ответ на комментарий с этим id.
  parentId   String   @default("")
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("book_comments")
}

/// Суточный счётчик. Одна строка на день, вид и корзину — без журнала визитов.
model DailyMetric {
  day    String
  kind   String
  bucket String
  total  Int    @default(0)

  @@id([day, kind, bucket])
  @@map("daily_metrics")
}

/// Сколько человек дочитал главу. Хранится максимум, повторный заход строку не плодит.
model ReadProgress {
  userId    String
  projectId String
  chapterId String
  /// 0–100, максимальная доля прокрутки.
  percent   Int      @default(0)
  charsSeen Int      @default(0)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, chapterId])
  @@index([projectId])
  @@index([userId, updatedAt])
  @@map("read_progress")
}

/// Встроенный блок для бесплатного тарифа и гостей.
model HouseAd {
  id       String  @id
  title    String
  body     String
  href     String
  enabled  Boolean @default(true)
  audience String  @default("free")
  sort     Int     @default(0)

  @@map("house_ads")
}

/// Подключение площадки автора. Секрет в базе только шифром.
model PublishAccount {
  id           String   @id @default(cuid())
  userId       String
  /// sponsr | vk | telegram | discord | boosty
  platform     String
  label        String   @default("")
  secretCipher String   @default("")
  secretHint   String   @default("")
  /// Открытые поля: ownerId у ВК, chatId у Telegram.
  meta         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
  @@map("publish_accounts")
}

/// Логин и пароль площадки. Шифр v1 открывается только в браузере. Шифр сервера нужен, чтобы взять новый токен.
model PublishVault {
  id           String   @id @default(cuid())
  userId       String
  platform     String
  loginSeal    String
  passwordSeal String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
  @@map("publish_vaults")
}

/// Проект площадки и книга на сайте. Одна связь для Sponsr и будущих книг других сайтов.
model PublishLink {
  id          String   @id @default(cuid())
  userId      String
  /// sponsr | boosty | patreon | author_today | litnet | wattpad | ficbook | rulate
  platform    String
  remoteId    String
  remoteTitle String   @default("")
  remoteUrl   String   @default("")
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, platform, remoteId])
  @@index([projectId])
  @@map("publish_links")
}

/// Одна попытка выложить главу на площадку.
model PublishDelivery {
  id        String   @id @default(cuid())
  userId    String
  chapterId String
  projectId String
  /// site | sponsr | vk | telegram | discord | boosty | patreon | author_today | litnet | wattpad | ficbook | rulate
  platform  String
  /// ok | error
  status    String
  remoteId  String   @default("")
  remoteUrl String   @default("")
  error     String   @default("")
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([chapterId, createdAt])
  @@map("publish_deliveries")
}

/// Короткая запись подписчику книги: вышла новая глава.
model ReaderNotice {
  id           String   @id @default(cuid())
  userId       String
  projectId    String
  chapterId    String
  bookTitle    String
  chapterTitle String
  href         String
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId, createdAt])
  @@map("reader_notices")
}

/// Событие аккаунта: глава, комментарий, ответ, запись блога, замечание читателя.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// chapter | book_comment | comment_reply | blog_post | blog_comment | reader_report | publish_error | book_subscription | follow | blog_donation | blog_report | book_status | digest
  kind      String
  title     String
  body      String    @default("")
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  /// Повтор того же события этому человеку не создаёт вторую строку.
  eventKey  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Публичный материал закрыт для перечисленных стран. Редактор автора не смотрит эту таблицу.
model GeoBlock {
  id        String   @id @default(cuid())
  kind      String
  targetId  String
  countries String[]
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, targetId])
  @@index([kind])
  @@map("geo_blocks")
}
